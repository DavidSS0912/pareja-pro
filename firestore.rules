rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMemberOfHouse(houseId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/houses/$(houseId)) &&
             request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.members;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.data.name is string;
    }

    match /houses/{houseId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members
                    && request.resource.data.members is list
                    && request.resource.data.name is string;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
                    && request.resource.data.members is list
                    && request.resource.data.name is string;
    }

    match /invitations/{inviteId} {
      allow read: if request.auth != null 
                  && (request.auth.uid == resource.data.fromUid || request.auth.token.email == resource.data.toEmail);
      allow create: if isMemberOfHouse(request.resource.data.houseId) 
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.houseId is string
                    && request.resource.data.fromUid is string
                    && request.resource.data.toEmail is string;
      allow update: if request.auth != null 
                    && (request.auth.uid == resource.data.fromUid || (request.auth.token.email == resource.data.toEmail && request.resource.data.accepted == true))
                    && request.resource.data.houseId == resource.data.houseId
                    && request.resource.data.fromUid == resource.data.fromUid
                    && request.resource.data.toEmail == resource.data.toEmail
                    && request.resource.data.accepted is bool;
    }

    function isValidIncome(data) {
      return data.houseId is string
          && data.amount is number
          && data.type is string
          && data.date is string;
    }

    match /incomes/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidIncome(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId) && isValidIncome(request.resource.data);
    }

    function isValidExpense(data) {
      return data.houseId is string
          && data.amount is number
          && data.desc is string
          && data.split is number
          && data.date is string;
    }

    match /expenses/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidExpense(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId) && isValidExpense(request.resource.data);
    }

    function isValidBudget(data) {
      return data.houseId is string
          && data.base is number
          && data.spent is number
          && data.category is string;
    }

    match /budgets/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidBudget(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId) && isValidBudget(request.resource.data);
    }

    function isValidCard(data) {
      return data.houseId is string
          && data.limit is number
          && data.balance is number
          && data.name is string;
    }

    match /cards/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidCard(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId) && isValidCard(request.resource.data);
    }

    function isValidAsset(data) {
      return data.houseId is string
          && data.value is number
          && data.name is string;
    }

    match /assets/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidAsset(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId) && isValidAsset(request.resource.data);
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMemberOfHouse(houseId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/houses/$(houseId)) &&
             request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.members;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /houses/{houseId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
    }

    match /invitations/{inviteId} {
      allow read: if request.auth != null;
      allow create: if isMemberOfHouse(request.resource.data.houseId) && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && (request.auth.uid == resource.data.fromUid || request.resource.data.accepted == true);
    }

    match /incomes/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId);
    }

    match /expenses/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId);
    }

    match /budgets/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId);
    }

    match /cards/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId);
    }

    match /assets/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId);
      allow update: if isMemberOfHouse(resource.data.houseId) && isMemberOfHouse(request.resource.data.houseId);
    }
  }
}

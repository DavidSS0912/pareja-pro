rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /houses/{houseId} {
      allow read, update: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
    }
    match /invitations/{inviteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid != resource.data.fromUid;
    }
    match /incomes/{docId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth != null && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.members.hasAny([request.auth.uid]);
    }
    match /expenses/{docId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth != null && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.members.hasAny([request.auth.uid]);
    }
    match /budgets/{docId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth != null && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.members.hasAny([request.auth.uid]);
    }
    match /cards/{docId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth != null && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.members.hasAny([request.auth.uid]);
    }
    match /assets/{docId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth != null && get(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.members.hasAny([request.auth.uid]);
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isMemberOfHouse(houseId) {
      return request.auth != null && 
             exists(/databases/$(database)/documents/houses/$(houseId)) &&
             request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.members;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.data.name is string;
    }

    match /houses/{houseId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
                    && request.resource.data.members is list;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members
                    && request.resource.data.members is list;
    }

    match /invitations/{inviteId} {
      allow read: if request.auth != null;
      allow create: if isMemberOfHouse(request.resource.data.houseId) 
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.houseId is string
                    && request.resource.data.fromUid is string
                    && request.resource.data.toEmail is string;
      allow update: if request.auth != null 
                    && (request.auth.uid == resource.data.fromUid || request.resource.data.accepted == true)
                    && request.resource.data.accepted is bool;
    }

    match /incomes/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create, update: if isMemberOfHouse(request.resource.data.houseId)
                            && request.resource.data.amount is number
                            && request.resource.data.type is string
                            && request.resource.data.date is string;
    }

    match /expenses/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create, update: if isMemberOfHouse(request.resource.data.houseId)
                            && request.resource.data.amount is number
                            && request.resource.data.desc is string
                            && request.resource.data.split is number
                            && request.resource.data.date is string;
    }

    match /budgets/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create, update: if isMemberOfHouse(request.resource.data.houseId)
                            && request.resource.data.base is number
                            && request.resource.data.spent is number
                            && request.resource.data.category is string;
    }

    match /cards/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create, update: if isMemberOfHouse(request.resource.data.houseId)
                            && request.resource.data.limit is number
                            && request.resource.data.balance is number
                            && request.resource.data.name is string;
    }

    match /assets/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create, update: if isMemberOfHouse(request.resource.data.houseId)
                            && request.resource.data.value is number
                            && request.resource.data.name is string;
    }
  }
}

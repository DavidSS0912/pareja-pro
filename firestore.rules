rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMemberOfHouse(houseId) {
      return request.auth != null &&
             exists(/databases/$(database)/documents/houses/$(houseId)) &&
             request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.members;
    }

    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
                   && (request.resource.data.houseId == resource.data.houseId 
                       || (request.resource.data.houseId is string 
                           && request.auth.uid in getAfter(/databases/$(database)/documents/houses/$(request.resource.data.houseId)).data.members));
    }

    match /houses/{houseId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members
                    && request.resource.data.members is list;
      allow update: if request.auth != null && 
                    (
                      (request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members)
                      ||
                      (
                        request.auth.uid in request.resource.data.members
                        && !(request.auth.uid in resource.data.members)
                        && request.resource.data.lastInviteId is string
                        && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.lastInviteId)).data.accepted == true
                        && getAfter(/databases/$(database)/documents/invitations/$(request.resource.data.lastInviteId)).data.houseId == houseId
                      )
                    );
    }

    match /invitations/{inviteId} {
      allow get: if request.auth != null;
      allow create: if isMemberOfHouse(request.resource.data.houseId)
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.houseId is string
                    && request.resource.data.fromUid is string;
      allow update: if request.auth != null
                    && request.resource.data.houseId == resource.data.houseId
                    && request.resource.data.fromUid == resource.data.fromUid
                    && request.resource.data.accepted == true;
    }

    function isValidIncome(data) {
      return data.houseId is string
          && data.amount is number
          && data.type is string
          && data.date is string;
    }

    match /incomes/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidIncome(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && request.resource.data.houseId == resource.data.houseId && isValidIncome(request.resource.data);
    }

    function isValidExpense(data) {
      return data.houseId is string
          && data.amount is number
          && data.desc is string
          && data.splitType is string
          && data.currency is string
          && data.category is string
          && data.paidBy is string
          && data.date is string
          && data.isPrivate is bool;
    }

    match /expenses/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidExpense(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && request.resource.data.houseId == resource.data.houseId && isValidExpense(request.resource.data);
    }

    function isValidBudget(data) {
      return data.houseId is string
          && data.base is number
          && data.spent is number
          && data.category is string;
    }

    match /budgets/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidBudget(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && request.resource.data.houseId == resource.data.houseId && isValidBudget(request.resource.data);
    }

    function isValidCard(data) {
      return data.houseId is string
          && data.limit is number
          && data.balance is number
          && data.name is string;
    }

    match /cards/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidCard(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && request.resource.data.houseId == resource.data.houseId && isValidCard(request.resource.data);
    }

    function isValidAsset(data) {
      return data.houseId is string
          && data.value is number
          && data.name is string;
    }

    match /assets/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidAsset(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && request.resource.data.houseId == resource.data.houseId && isValidAsset(request.resource.data);
    }

    function isValidProject(data) {
      return data.houseId is string
          && data.name is string
          && data.targetAmount is number
          && data.savedAmount is number
          && data.monthlyQuota is number
          && data.targetAccount is string
          && data.priority is number
          && data.status is string
          && data.startDate is string;
    }

    match /projects/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidProject(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && request.resource.data.houseId == resource.data.houseId && isValidProject(request.resource.data);
    }

    function isValidContribution(data) {
      return data.houseId is string
          && data.projectId is string
          && data.userId is string
          && data.amount is number
          && data.date is string;
    }

    match /contributions/{docId} {
      allow read, delete: if isMemberOfHouse(resource.data.houseId);
      allow create: if isMemberOfHouse(request.resource.data.houseId) && isValidContribution(request.resource.data);
      allow update: if isMemberOfHouse(resource.data.houseId) && request.resource.data.houseId == resource.data.houseId && isValidContribution(request.resource.data);
    }
  }
}
